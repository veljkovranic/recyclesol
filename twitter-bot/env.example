# Twitter API Credentials
# Get these from https://developer.twitter.com/en/portal/dashboard
# You need a project with "Read and Write" permissions

TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# Solana RPC Endpoint
# For production, use a dedicated RPC provider (QuickNode, Helius, Alchemy)
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Bot Configuration
# How often to check for new mentions (in milliseconds)
POLL_INTERVAL_MS=60000

# Website URL to include in replies
WEBSITE_URL=https://pumpcleanup.com

# Dry run mode - set to "true" to test without posting
# The bot will log what it would post but won't actually reply
DRY_RUN=false

